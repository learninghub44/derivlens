# ── Deriv application (register at https://api.deriv.com/dashboard) ──
DERIV_APP_ID=
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_SECRET=
DERIV_OAUTH_REDIRECT_URI=
NEXT_PUBLIC_DERIV_APP_ID=
NEXT_PUBLIC_DERIV_REDIRECT_URI=

# ── Deriv affiliate (optional — leave blank until you have a real link) ──
NEXT_PUBLIC_DERIV_AFFILIATE_URL=

# ── Groq (AI analyst layer) ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database / Supabase ──
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Branding (optional overrides — sensible defaults are used if blank) ──
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_DESCRIPTION=
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_FAVICON_URL=
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=
NEXT_PUBLIC_BRAND_SECONDARY_COLOR=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ── Social links (leave blank to hide from landing page + footer) ──
NEXT_PUBLIC_SOCIAL_WHATSAPP=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_DISCORD=
